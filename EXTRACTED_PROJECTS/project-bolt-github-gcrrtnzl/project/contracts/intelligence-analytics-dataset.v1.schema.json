{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aghbari://contracts/intelligence-analytics-dataset/v1",
  "title": "Aghbari Intelligence Analytics Dataset Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "source_system",
    "source_dataset_id",
    "source_version",
    "contract_version",
    "schema_version",
    "tenant_id",
    "created_at",
    "data_period_start",
    "data_period_end",
    "record_count",
    "accepted_record_count",
    "rejected_record_count",
    "data_quality_score",
    "provenance_ref",
    "processing_status",
    "activation_status"
  ],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "source_system": { "type": "string", "minLength": 1 },
    "source_dataset_id": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string", "minLength": 1 },
    "contract_version": { "const": "1.0" },
    "schema_version": { "const": "1.0" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "data_period_start": { "type": "string", "format": "date" },
    "data_period_end": { "type": "string", "format": "date" },
    "record_count": { "type": "integer", "minimum": 0 },
    "accepted_record_count": { "type": "integer", "minimum": 0 },
    "rejected_record_count": { "type": "integer", "minimum": 0 },
    "data_quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "provenance_ref": { "type": "string", "minLength": 1 },
    "processing_status": {
      "type": "string",
      "enum": ["RECEIVED", "VALIDATING", "NORMALIZING", "TENANT_BOUND", "QUALITY_CHECKED", "READY", "ACTIVE", "ANALYZED", "REJECTED", "PROCESSING_FAILED", "QUARANTINED"]
    },
    "activation_status": {
      "type": "string",
      "enum": ["PENDING", "ACTIVE", "INACTIVE", "REJECTED"]
    },
    "analysis_run_id": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "processing_status": { "const": "ACTIVE" } } },
      "then": { "properties": { "activation_status": { "const": "ACTIVE" } } }
    }
  ]
}
